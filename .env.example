# ---------------------------------------------------------------------------
# Afghanistan News — environment template (copy to .env)
# ---------------------------------------------------------------------------

# Core
ENV=local
HTTP_ADDR=0.0.0.0:8080
LOG_LEVEL=info

# Database: postgres in production, sqlite acceptable for a laptop demo
DB_DRIVER=postgres
DATABASE_URL=postgres://afnews:afnews@127.0.0.1:5432/afnews?sslmode=disable
# DB_DRIVER=sqlite
# DATABASE_URL=file:./data/afnews.db

# Ingestion worker
WORKER_ENABLED=true          # run the worker inside the api process (dev only)
WORKER_CONCURRENCY=8
DOMAIN_CONCURRENCY=2
INGEST_BATCH_SIZE=24
SCHEDULER_TICK=5s
MAX_ITEMS_PER_FEED_RUN=60
QUARANTINE_AFTER=12
BREAKING_MAX_PER_RUN=2        # a feed may flag at most this many items per poll as breaking
ADAPTIVE_POLLING=true

# Fetching / SSRF
FETCH_TIMEOUT=20s
MAX_RESPONSE_BYTES=2097152
ALLOW_PRIVATE_FETCH=false    # never true in production (SSRF guard)
USER_AGENT=AfghanistanNewsBot/1.0 (+https://afghanistan.news/bot)

# Feed pack + rollout wave (1=CORE, 2=+topics, 3=+selected search, 4=long tail)
FEED_PACK_PATH=resources/feedpacks/afghanistan-global-news-master-v0.2.opml
FEED_ACTIVATION_WAVE=1

# API protection
RATE_LIMIT_PER_MINUTE=240
CORS_ALLOWED_ORIGINS=https://afghanistan.news

# Admin console (rotate both in production; the seed is development-only)
ADMIN_SESSION_KEY=change-me-to-32-bytes-minimum-secret
ADMIN_SESSION_TTL=8h
ADMIN_SEED_USERNAME=admin
ADMIN_PASSWORD_HASH=         # bcrypt hash; empty = dev seed admin/afnews-admin
ADMIN_STATIC_DIR=../admin
APP_STATIC_DIR=../app

# Push (leave PUSH_DRY_RUN=true to record events without delivering)
PUSH_DRY_RUN=true
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
PUSH_MAX_PER_HOUR=6
PUSH_MAX_PER_DAY=40
